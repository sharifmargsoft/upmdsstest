APP_NAME="UPMDSS DSS Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.upmdss.in

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ─── PostgreSQL ────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=upmdss
DB_USERNAME=upmdss_app
DB_PASSWORD=your_strong_password_here
DB_SCHEMA=public

# Read replica (for heavy report queries)
DB_READ_HOST=127.0.0.1
DB_READ_PORT=5432

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3

# ─── Cache & Session ───────────────────────────────────────
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480          # 8 hours
QUEUE_CONNECTION=redis
BROADCAST_DRIVER=redis

# ─── Sanctum ───────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=upmdss.in,localhost:3000
SESSION_DOMAIN=.upmdss.in

# ─── S3 / MinIO Storage ────────────────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=upmdss-evidence
AWS_URL=
AWS_ENDPOINT=                 # Set for MinIO

# ─── Mail ──────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@upmdss.in"
MAIL_FROM_NAME="UPMDSS Portal"

# ─── External API Keys ─────────────────────────────────────
UP_MINES_API_URL=https://upmine.up.gov.in/api
UP_MINES_API_KEY=
VAHAN_API_URL=https://vahan.parivahan.gov.in/api
VAHAN_API_KEY=
RAJKOSH_API_URL=https://rajkosh.up.nic.in/api
RAJKOSH_API_KEY=

# ─── SMS (for e-Notice delivery) ───────────────────────────
SMS_GATEWAY=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=UPMDSS
MSG91_TEMPLATE_ID=

# ─── Rate Limiting ─────────────────────────────────────────
API_RATE_LIMIT=120             # requests per minute per user
API_RATE_LIMIT_GUEST=20        # for unauthenticated

# ─── Dashboard cache TTL (seconds) ─────────────────────────
DASHBOARD_CACHE_TTL=300
MV_REFRESH_INTERVAL=300
